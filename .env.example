# =============================================================================
# Economic Intelligence Framework (EIF) — example environment configuration
# =============================================================================
# Copy this file to `.env` and fill in values as needed.
#   cp .env.example .env
#
# NOTHING here is required to run EIF in its default (fully local, deterministic
# mock provider) mode. External model providers are opt-in.
# Never commit a real `.env` — it is git-ignored.
# -----------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------------
# Organization / tenant identity attached to evidence and events.
EIF_ORGANIZATION_ID=demo-org
EIF_ORGANIZATION_CURRENCY=ZAR

# Path to a YAML/TOML config file (optional). CLI/API also accept --config.
# EIF_CONFIG_FILE=./eif.yaml

# Logging: DEBUG | INFO | WARNING | ERROR ; format: json | text
EIF_LOG_LEVEL=INFO
EIF_LOG_FORMAT=json

# --- Persistence --------------------------------------------------------------
# SQLAlchemy URL. Defaults to a local SQLite file. Use postgres in production:
#   postgresql+psycopg://eif:eif@localhost:5432/eif
EIF_DATABASE_URL=sqlite:///./eif.db

# --- Providers (all optional) -------------------------------------------------
# Default provider is the deterministic "mock" provider (no network, no keys).
# EIF_DEFAULT_LLM_PROVIDER=mock

# OpenAI-compatible endpoints (OpenAI, Azure OpenAI, vLLM, Ollama, etc.)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=...

# --- Privacy / local mode -----------------------------------------------------
# When true, EIF refuses to call any provider that would send evidence off-host.
EIF_PRIVATE_MODE=false

# --- Security -----------------------------------------------------------------
# Maximum accepted evidence file size in bytes (default 25 MiB).
EIF_MAX_FILE_BYTES=26214400
# Enable PII redaction hooks on stored evidence content.
EIF_REDACT_PII=false
